{
  "name": "AirDroid",
  "slug": "airdroid",
  "identifier": "com.capytown.airdroid",
  "version": "0.1.3",
  "buildVersion": 4,
  "copyright": "© 2026 CapyTown",
  "out": "build",
  "macos": {
    "minimumSystemVersion": "12.0",
    "infoPlist": {
      "LSUIElement": true,
      "LSApplicationCategoryType": "public.app-category.utilities",
      "NSLocalNetworkUsageDescription": "AirDroid connects to Android devices on your network for wireless debugging.",
      "NSBonjourServices": [
        "_adb._tcp",
        "_adb-tls-connect._tcp",
        "_adb-tls-pairing._tcp"
      ]
    },
    "icon": "AppIcon.icon"
  },
  "linux": {
    "webview": false,
    "comment": "Mirror and control Android phones",
    "categories": [
      "Utility"
    ],
    "depends": [
      "libayatana-appindicator3-1"
    ]
  },
  "i18n": {
    "dir": "locales",
    "source": "en"
  }
}
