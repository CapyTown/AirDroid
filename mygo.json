{
  "name": "MyGo",
  "slug": "mygo",
  "identifier": "dev.egoist.mygo",
  "version": "0.1.0",
  "copyright": "© 2026 MyGo contributors",
  "out": "build",
  "macos": {
    "minimumSystemVersion": "12.0",
    "infoPlist": {
      "LSUIElement": true,
      "LSApplicationCategoryType": "public.app-category.utilities",
      "NSLocalNetworkUsageDescription": "MyGo connects to Android devices on your network for wireless debugging.",
      "NSBonjourServices": ["_adb._tcp", "_adb-tls-connect._tcp", "_adb-tls-pairing._tcp"]
    }
  },
  "linux": { "webview": false }
}
